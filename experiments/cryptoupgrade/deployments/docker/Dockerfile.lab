# Support setting various labels on the final image
ARG COMMIT=""
ARG VERSION=""
ARG BUILDNUM=""

FROM golang:1.26-alpine

RUN apk add --no-cache ca-certificates gcc git linux-headers musl-dev

WORKDIR /go-ethereum

ENV CGO_ENABLED=0
ARG GOPROXY="https://proxy.golang.org,direct"
ENV GOPROXY=$GOPROXY

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go run build/ci.go install ./cmd/geth

ENV CRYPTOUPGRADE_MODULE=/go-ethereum
ENV GETH_CRYPTOUPGRADE_PLUGIN_DIR=/plugin
ENV PATH="/go-ethereum/build/bin:${PATH}"

RUN mkdir -p /data /plugin

EXPOSE 8545 8546 30303 30303/udp
ENTRYPOINT ["geth"]

ARG COMMIT=""
ARG VERSION=""
ARG BUILDNUM=""

LABEL commit="$COMMIT" version="$VERSION" buildnum="$BUILDNUM"
