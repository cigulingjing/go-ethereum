\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Upgrade Latency and Upload Cost}{8}{subsection.4.2}\protected@file@percent }
\newlabel{sec4.2}{{4.2}{8}{Upgrade Latency and Upload Cost}{subsection.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Upgrade latency in the five-node Clique private chain. The measurement starts when the controller submits the upgrade transaction and ends when every target node can return the expected output through \texttt  {CodeStorage.callFunc}. The event-to-all-complete interval includes RPC polling and node-local preparation, not only internal plugin compilation.}}{9}{figure.4.2}\protected@file@percent }
\newlabel{fig:lab1-upgrade-latency}{{2}{9}{Upgrade latency in the five-node Clique private chain. The measurement starts when the controller submits the upgrade transaction and ends when every target node can return the expected output through \texttt {CodeStorage.callFunc}. The event-to-all-complete interval includes RPC polling and node-local preparation, not only internal plugin compilation}{figure.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Upload and deployment cost for the auxiliary Lab1 cost experiment. The upgrade path uses \texttt  {CodeStorage.uploadCode} and emits an upgrade event, whereas the Contract path deploys a Solidity implementation. The figure reports total transaction-level setup cost, not an isolated event-log gas component.}}{10}{figure.4.3}\protected@file@percent }
\newlabel{fig:lab1-deployment-cost}{{3}{10}{Upload and deployment cost for the auxiliary Lab1 cost experiment. The upgrade path uses \texttt {CodeStorage.uploadCode} and emits an upgrade event, whereas the Contract path deploys a Solidity implementation. The figure reports total transaction-level setup cost, not an isolated event-log gas component}{figure.4.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Execution Efficiency}{10}{subsection.4.3}\protected@file@percent }
\newlabel{sec4.3}{{4.3}{10}{Execution Efficiency}{subsection.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Execution latency after setup. Upgrade invokes a dynamically loaded Native module through CodeStorage, Precompile invokes a client-native Precompiled Contract, and Contract executes a Solidity implementation. Latency is measured by repeated \texttt  {eth\_call} after warm-up.}}{11}{figure.4.4}\protected@file@percent }
\newlabel{fig:lab2-execution-latency}{{4}{11}{Execution latency after setup. Upgrade invokes a dynamically loaded Native module through CodeStorage, Precompile invokes a client-native Precompiled Contract, and Contract executes a Solidity implementation. Latency is measured by repeated \texttt {eth\_call} after warm-up}{figure.4.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gas estimates for steady-state algorithm invocation. Values are obtained from \texttt  {eth\_estimateGas}; they reflect the prototype pricing model and are not receipt \texttt  {gasUsed}.}}{12}{figure.4.5}\protected@file@percent }
\newlabel{fig:lab2-gas-estimate}{{5}{12}{Gas estimates for steady-state algorithm invocation. Values are obtained from \texttt {eth\_estimateGas}; they reflect the prototype pricing model and are not receipt \texttt {gasUsed}}{figure.4.5}{}}
